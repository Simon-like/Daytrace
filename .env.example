# Public development site: http://127.0.0.1:3000
SITE_HOST=127.0.0.1
SITE_PORT=3000

# Nest listens separately; browsers do not receive this internal origin.
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_ORIGIN=http://127.0.0.1:3001

# Synthetic records only. Never point public build inputs at real private content.
CONTENT_ROOT=./apps/api/fixtures/content

# Production owner authentication: uncomment and replace every placeholder.
# AUTH_PROVIDER=auth0
# PUBLIC_ORIGIN=https://daytrace.example.com
# SESSION_DATABASE_PATH=/absolute/private-data/daytrace-sessions.sqlite
# AUTH0_ISSUER=https://your-tenant.auth0.com/
# AUTH0_CLIENT_ID=replace-with-auth0-client-id
# AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
# OWNER_IDENTITIES=[{"issuer":"https://your-tenant.auth0.com/","subject":"replace-with-owner-sub"}]
